// TerangaMeet v2 — Prisma schema (PostgreSQL)
// Modeled on the Django "Meet" data model (User, Room, ResourceAccess, Recording, File, Application).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  ADMIN
  OWNER
}

enum RoomAccessLevel {
  PUBLIC
  TRUSTED
  RESTRICTED
}

enum ScheduledMeetingStatus {
  SCHEDULED
  CANCELLED
}

enum AttendeeResponse {
  NEEDS_ACTION
  ACCEPTED
  DECLINED
  TENTATIVE
}

enum RecordingStatus {
  INITIATED
  ACTIVE
  STOPPED
  SAVED
  ABORTED
  FAILED_TO_START
  FAILED_TO_STOP
  NOTIFICATION_SUCCEEDED
}

enum RecordingMode {
  SCREEN_RECORDING
  TRANSCRIPT
}

enum FileUploadState {
  PENDING
  ANALYZING
  READY
}

enum FileType {
  BACKGROUND_IMAGE
}

model User {
  id         String   @id @default(uuid())
  sub        String?  @unique
  email      String?
  adminEmail String?  @unique
  fullName   String?
  shortName  String?
  language   String   @default("fr-fr")
  timezone   String   @default("UTC")
  isDevice   Boolean  @default(false)
  isStaff    Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  roomAccesses      RoomAccess[]
  recordingAccesses RecordingAccess[]
  recordingsCreated Recording[]       @relation("RecordingCreator")
  files             File[]            @relation("FileCreator")
  notes             MeetingNote[]
  meetingSessions   MeetingSession[]  @relation("MeetingCreator")
  roomInvitesSent   RoomInvitee[]     @relation("RoomInviteeInviter")
  meetingsOrganized ScheduledMeeting[]
  googleAccount     GoogleAccount?

  @@index([email])
  @@map("users")
}

model MeetingNote {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  /** LiveKit room name (room UUID for registered rooms, slug for ad-hoc). */
  roomKey   String
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, roomKey])
  @@map("meeting_notes")
}

model Room {
  id            String          @id @default(uuid())
  name          String
  slug          String?         @unique
  accessLevel   RoomAccessLevel @default(PUBLIC)
  configuration Json            @default("{}")
  pinCode       String?         @unique
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  accesses   RoomAccess[]
  recordings Recording[]
  sessions   MeetingSession[]
  invitees   RoomInvitee[]
  scheduled  ScheduledMeeting[]

  @@map("rooms")
}

/// Expected participants of a room, by email. Keyed on the address rather than
/// a User so people can be listed before their first sign-in: they are matched
/// on the email of their SenID account when they arrive. In a restricted room a
/// listed person skips the waiting room; a co-organizer also gets moderation
/// rights at every session (resolved as Role.ADMIN).
model RoomInvitee {
  id            String   @id @default(uuid())
  room          Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId        String
  /// Always stored lowercased; compared against the lowercased account email.
  email         String
  isCoOrganizer Boolean  @default(false)
  invitedBy     User?    @relation("RoomInviteeInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([roomId, email])
  @@index([email])
  @@map("room_invitees")
}

/// A real meeting occurrence, tracked from LiveKit room_started/room_finished
/// webhooks. Powers the admin history & statistics (durations, frequency, top creators).
model MeetingSession {
  id              String    @id @default(uuid())
  livekitSid      String?   @unique
  livekitRoomName String
  title           String?
  room            Room?     @relation(fields: [roomId], references: [id], onDelete: SetNull)
  roomId          String?
  creator         User?     @relation("MeetingCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  creatorId       String?
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  durationSec     Int?
  maxParticipants Int       @default(0)
  totalJoins      Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  participants MeetingParticipant[]
  recordings   Recording[]

  @@index([startedAt])
  @@index([creatorId])
  @@index([roomId])
  @@map("meeting_sessions")
}

/// One row per participant per meeting session. Entry = first join, exit = last
/// leave: reconnections keep the earliest joinedAt and update lastLeftAt only.
model MeetingParticipant {
  id            String         @id @default(uuid())
  session       MeetingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId     String
  identity      String
  name          String?
  firstJoinedAt DateTime       @default(now())
  lastLeftAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([sessionId, identity])
  @@index([sessionId])
  @@index([identity])
  @@map("meeting_participants")
}

model RoomAccess {
  id        String   @id @default(uuid())
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, roomId])
  @@map("room_accesses")
}

model Recording {
  id        String          @id @default(uuid())
  room      Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId    String
  status    RecordingStatus @default(INITIATED)
  workerId  String?
  mode      RecordingMode
  options   Json            @default("{}")
  // Denormalized owner (who started it), for sorting/filtering in the admin UI.
  creator   User?           @relation("RecordingCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  creatorId String?
  /// The meeting occurrence this recording belongs to. Set when the egress is
  /// started; lets participants of that session reach their own recordings.
  session   MeetingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  sessionId String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  accesses RecordingAccess[]

  @@index([creatorId])
  @@index([sessionId])
  @@map("recordings")
}

model RecordingAccess {
  id          String    @id @default(uuid())
  recording   Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  recordingId String
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String?
  team        String?
  role        Role      @default(MEMBER)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, recordingId])
  @@map("recording_accesses")
}

model File {
  id                   String          @id @default(uuid())
  type                 FileType        @default(BACKGROUND_IMAGE)
  title                String
  creator              User?           @relation("FileCreator", fields: [creatorId], references: [id])
  creatorId            String?
  filename             String
  uploadState          FileUploadState @default(PENDING)
  mimetype             String?
  size                 BigInt?
  description          String?
  malwareDetectionInfo Json?
  deletedAt            DateTime?
  hardDeletedAt        DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@map("files")
}

model Application {
  id           String   @id @default(uuid())
  name         String
  isActive     Boolean  @default(true)
  clientId     String   @unique
  clientSecret String
  scopes       String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  domains ApplicationDomain[]

  @@map("applications")
}

model ApplicationDomain {
  id            String      @id @default(uuid())
  domain        String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String

  @@unique([applicationId, domain])
  @@map("application_domains")
}

/// Platform-wide settings an administrator toggles at runtime (e.g. the
/// calendar). A key/value table rather than env vars, so a change needs no
/// redeploy, and rather than Redis, so it survives a cache flush.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

/// A meeting planned at a date, in a room: the calendar side of TerangaMeet.
/// Invitations go out as iCalendar (.ics) emails whose UID derives from the
/// id; `sequence` is bumped on every change so calendars apply updates and
/// cancellations in order (RFC 5545).
model ScheduledMeeting {
  id            String                 @id @default(uuid())
  room          Room                   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId        String
  organizer     User                   @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  organizerId   String
  title         String
  description   String                 @default("")
  startsAt      DateTime
  endsAt        DateTime
  timezone      String                 @default("Africa/Dakar")
  status        ScheduledMeetingStatus @default(SCHEDULED)
  sequence      Int                    @default(0)
  /// Set once the event is mirrored in the organiser's Google Calendar (phase 2).
  googleEventId String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  attendees MeetingAttendee[]

  @@index([organizerId, startsAt])
  @@index([startsAt])
  @@map("scheduled_meetings")
}

/// A guest of a scheduled meeting, by email (lowercased) — members of the
/// platform or not, like the room participant list.
model MeetingAttendee {
  id        String           @id @default(uuid())
  meeting   ScheduledMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  meetingId String
  email     String
  response  AttendeeResponse @default(NEEDS_ACTION)
  /// Co-host: made co-organizer of the meeting's room (moderates every session).
  isCoHost  Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@unique([meetingId, email])
  @@index([email])
  @@map("meeting_attendees")
}

/// A user's Google account, linked by them through OAuth consent so meetings
/// they schedule are created in their own Google Calendar (phase 2). The
/// refresh token is stored encrypted (AES-256-GCM, key in GOOGLE_TOKEN_KEY).
model GoogleAccount {
  id           String   @id @default(uuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String   @unique
  googleEmail  String
  refreshToken String
  scope        String
  connectedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("google_accounts")
}
