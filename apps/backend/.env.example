# ---- Runtime ----
NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:3000
# In production, serve the built SPA from the backend:
SERVE_FRONTEND=false
FRONTEND_DIST=../frontend/dist

# ---- Data stores ----
DATABASE_URL=postgresql://terangameet:terangameet@localhost:5432/terangameet
REDIS_URL=redis://localhost:6379/1

# ---- Sessions ----
SESSION_SECRET=please-change-me
SESSION_COOKIE_NAME=terangameet_sessionid

# ---- OIDC (Keycloak) ----
KEYCLOAK_HOST=keycloak.example.com
REALM_NAME=YOUR_REALM
# Optional explicit issuer (otherwise derived from host+realm):
# OIDC_ISSUER=https://keycloak.example.com/realms/YOUR_REALM
OIDC_RP_CLIENT_ID=meet
OIDC_RP_CLIENT_SECRET=
OIDC_RP_SCOPES=openid email profile
OIDC_USE_PKCE=true
OIDC_CALLBACK_PATH=/oidc/callback/

# ---- LiveKit ----
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_API_URL=http://localhost:7880
LIVEKIT_WS_URL=ws://localhost:7880
LIVEKIT_FORCE_WSS_PROTOCOL=false

# ---- Rooms ----
ALLOW_UNREGISTERED_ROOMS=true
RESOURCE_DEFAULT_ACCESS_LEVEL=public

# ---- Recording / storage (optional) ----
RECORDING_ENABLE=false
AWS_S3_ENDPOINT_URL=
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=terangameet-media-storage

# ---- Features ----
FILE_UPLOAD_ENABLED=false
ROOM_SUBTITLE_ENABLED=false
ROOM_TELEPHONY_ENABLED=false
