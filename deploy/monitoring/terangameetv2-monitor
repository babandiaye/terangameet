#!/usr/bin/env python3
"""Supervision de TerangaMeet : vérifie le service et prévient par email.

  terangameetv2-monitor check            (toutes les 5 min, par le timer)
  terangameetv2-monitor unit-failed UNIT (OnFailure= des unités systemd)
  terangameetv2-monitor test             (envoie un email de test)

Un email part quand une vérification passe en échec, puis quand elle revient
à la normale — pas à chaque passage, pour ne pas noyer les destinataires.
Destinataires : ALERT_EMAILS, sinon ADMIN_EMAILS, de .env.production. Envoi par
le SMTP de la plateforme (mêmes réglages que l'application).
Installé en root : install -o root -m 755 … /usr/local/sbin/terangameetv2-monitor
"""
import json, os, shutil, smtplib, socket, ssl, subprocess, sys, time, urllib.request
from datetime import datetime, timezone
from email.message import EmailMessage

ENV_FILE = "/opt/terangameetv2/apps/backend/.env.production"
STATE_FILE = "/var/lib/terangameetv2/monitor-state.json"
BACKUP_STATUS = "/var/lib/terangameetv2/backup-status.json"
LOCAL_READY = "http://127.0.0.1:4000/readyz"
PUBLIC_URL = "https://terangameet.unchk.sn/readyz"
CERT_HOST = "terangameet.unchk.sn"
BACKUP_MAX_AGE_H = 26
DISK_MAX_PCT = 90
CERT_MIN_DAYS = 30


def load_env():
    env = {}
    with open(ENV_FILE) as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            env[k.strip()] = v.strip().strip('"').strip("'")
    return env


def send(subject, body):
    env = load_env()
    rcpts = [e.strip() for e in (env.get("ALERT_EMAILS") or env.get("ADMIN_EMAILS", "")).split(",") if e.strip()]
    if not rcpts:
        print("Aucun destinataire (ALERT_EMAILS / ADMIN_EMAILS)", file=sys.stderr)
        return False
    msg = EmailMessage()
    sender = env.get("SMTP_FROM") or env.get("SMTP_USER", "")
    msg["From"] = f"TerangaMeet supervision <{sender}>"
    msg["To"] = ", ".join(rcpts)
    msg["Subject"] = f"[TerangaMeet] {subject}"
    msg.set_content(body + f"\n\n— {socket.gethostname()}, {datetime.now().strftime('%d/%m/%Y %H:%M')}\n")
    host, port = env.get("SMTP_HOST", ""), int(env.get("SMTP_PORT") or 587)
    use_ssl = env.get("SMTP_USE_SSL", "false").lower() == "true"
    use_tls = env.get("SMTP_USE_TLS", "true").lower() == "true"
    # Le serveur de l'université met ~10 s à saluer : délai large.
    smtp = smtplib.SMTP_SSL(host, port, timeout=60) if use_ssl else smtplib.SMTP(host, port, timeout=60)
    with smtp:
        if use_tls and not use_ssl:
            smtp.starttls(context=ssl.create_default_context())
        if env.get("SMTP_USER"):
            smtp.login(env["SMTP_USER"], env.get("SMTP_PASSWORD", ""))
        smtp.send_message(msg)
    return True


def http_ok(url):
    try:
        with urllib.request.urlopen(url, timeout=10) as r:
            return r.status == 200, f"HTTP {r.status}"
    except Exception as e:  # noqa: BLE001
        return False, str(e)


def checks():
    out = {}
    ok, detail = http_ok(LOCAL_READY)
    out["service"] = (ok, "Service et base/Redis joignables" if ok else f"Service ou base/Redis injoignable : {detail}")
    ok, detail = http_ok(PUBLIC_URL)
    out["public"] = (ok, "Site public joignable" if ok else f"Site public injoignable (nginx/TLS) : {detail}")
    try:
        with open(BACKUP_STATUS) as f:
            st = json.load(f)
        age_h = (time.time() - datetime.fromisoformat(st["finished_at"].replace("Z", "+00:00")).timestamp()) / 3600
        good = bool(st.get("ok")) and age_h < BACKUP_MAX_AGE_H
        out["backup"] = (good, f"Dernière sauvegarde : {'réussie' if st.get('ok') else 'EN ÉCHEC'}, il y a {age_h:.0f} h")
    except Exception as e:  # noqa: BLE001
        out["backup"] = (False, f"État de sauvegarde illisible : {e}")
    for path in ["/", "/var/backups"]:
        u = shutil.disk_usage(path)
        pct = u.used * 100 / u.total
        out[f"disk:{path}"] = (pct < DISK_MAX_PCT, f"Disque {path} rempli à {pct:.0f} %")
    try:
        der = ssl.get_server_certificate((CERT_HOST, 443))
        r = subprocess.run(["openssl", "x509", "-noout", "-enddate"], input=der, capture_output=True, text=True, check=True)
        end = datetime.strptime(r.stdout.strip().split("=", 1)[1], "%b %d %H:%M:%S %Y %Z").replace(tzinfo=timezone.utc)
        days = (end - datetime.now(timezone.utc)).days
        out["certificate"] = (days >= CERT_MIN_DAYS, f"Certificat TLS : expire dans {days} jours ({end:%d/%m/%Y})")
    except Exception as e:  # noqa: BLE001
        out["certificate"] = (False, f"Certificat TLS illisible : {e}")
    return out


def run_checks():
    results = checks()
    try:
        with open(STATE_FILE) as f:
            prev = json.load(f)
    except Exception:  # noqa: BLE001
        prev = {}
    failed = [k for k, (ok, _) in results.items() if not ok and prev.get(k, True)]
    recovered = [k for k, (ok, _) in results.items() if ok and prev.get(k) is False]
    lines = [f"{'OK ' if ok else 'KO '} {d}" for ok, d in results.values()]
    if failed:
        send("ALERTE : " + ", ".join(results[k][1] for k in failed)[:150], "Problème détecté :\n\n" + "\n".join(lines))
    if recovered:
        send("Rétabli : " + ", ".join(recovered), "Retour à la normale :\n\n" + "\n".join(lines))
    os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
    with open(STATE_FILE + ".tmp", "w") as f:
        json.dump({k: ok for k, (ok, _) in results.items()}, f)
    os.replace(STATE_FILE + ".tmp", STATE_FILE)
    print("\n".join(lines))


def unit_failed(unit):
    log = subprocess.run(["journalctl", "-u", unit, "-n", "40", "--no-pager"], capture_output=True, text=True).stdout
    send(f"ÉCHEC de {unit}", f"L'unité systemd {unit} est en échec.\n\nDernières lignes du journal :\n\n{log}")


if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else "check"
    if cmd == "check":
        run_checks()
    elif cmd == "unit-failed" and len(sys.argv) > 2:
        unit_failed(sys.argv[2])
    elif cmd == "test":
        print("envoyé" if send("Test de la supervision", "Ceci est un email de test de la supervision TerangaMeet.") else "non envoyé")
    else:
        print(__doc__)
        sys.exit(2)
